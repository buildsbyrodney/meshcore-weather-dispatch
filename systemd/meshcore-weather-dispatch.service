[Unit]
# Managed by MeshCore Weather Dispatch. Put local changes in a .d override.
Description=MeshCore Weather Dispatch (manual NWS alert console)
After=network-online.target nginx.service
Wants=network-online.target nginx.service

[Service]
Type=simple
User=weatherdispatch
Group=weatherdispatch
WorkingDirectory=/opt/meshcore-weather-dispatch
EnvironmentFile=/etc/meshcore-weather-dispatch/environment
Environment=WEATHER_DISPATCH_CONFIG=/etc/meshcore-weather-dispatch/config.yml
# One worker is required: each worker owns one NWS polling thread.
ExecStart=/opt/meshcore-weather-dispatch/.venv/bin/gunicorn --workers 1 --no-control-socket --worker-tmp-dir /dev/shm --bind 127.0.0.1:8080 --access-logfile - --error-logfile - 'dispatch:create_app()'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/meshcore-weather-dispatch

[Install]
WantedBy=multi-user.target
